{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SFDP: run demo",
      "type": "process",
      "command": "/usr/bin/make",
      "args": ["demo-sfdp"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "SFDP: run tests",
      "type": "process",
      "command": "/usr/bin/make",
      "args": ["test-sfdp"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "SFDP: view waveforms",
      "type": "process",
      "command": "/usr/bin/make",
      "args": ["waves-sfdp"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "UART: test receiver",
      "type": "process",
      "command": "/usr/bin/make",
      "args": ["test-uart"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "UART: view receiver waveforms",
      "type": "process",
      "command": "/usr/bin/make",
      "args": ["waves-uart"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "RTL: run simulation",
      "type": "process",
      "command": "/usr/bin/make",
      "args": ["test"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "RTL: check syntax",
      "type": "process",
      "command": "/usr/bin/make",
      "args": ["lint"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "RTL: view waveforms",
      "type": "process",
      "command": "/usr/bin/make",
      "args": ["waves"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
